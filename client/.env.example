# Groq (proposal generation)
GROQ_API_KEY=
# Optional model override:
# GROQ_MODEL=openai/gpt-oss-safeguard-20b

# Resend (contact form + proposal email) — Resend 6.x expects Node 20+
RESEND_API_KEY=
# Verified sender on your Resend domain (NOT @gmail.com). Add webfudge.in at https://resend.com/domains
# e.g. hello@webfudge.in or onboarding@resend.dev for testing only
RESEND_FROM_EMAIL=
# Inbox for contact form submissions (defaults to contact@webfudge.in)
CONTACT_EMAIL=
